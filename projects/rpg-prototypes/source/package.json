{
  "name": "realm-chips",
  "version": "1.0.0",
  "description": "A Pokemon-style pixel-art RPG built on Phaser 3 and Electron",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "NODE_ENV=development concurrently \"vite\" \"wait-on tcp:5173 && electron .\"",
    "electron:build": "vite build && electron-builder"
  },
  "build": {
    "appId": "com.realmchips.game",
    "productName": "Realm Chips",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "mac": {
      "category": "public.app-category.games",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "keywords": ["phaser", "rpg", "pokemon", "electron", "typescript"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1",
    "phaser": "^3.60.0",
    "typescript": "^5.4.0",
    "vite": "^5.0.0",
    "wait-on": "^9.0.4"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  }
}
