{
  "name": "tile-editor",
  "version": "1.0.0",
  "description": "Pixel RPG Tile Map Editor — GBA/Pokemon/Final Fantasy style",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "generate-tileset": "node scripts/generate-tileset.js",
    "dist": "electron-builder --mac"
  },
  "build": {
    "appId": "com.tileEditor.app",
    "productName": "Tile Editor",
    "mac": {
      "target": "dir",
      "category": "public.app-category.developer-tools"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "core/**",
      "ui/**",
      "tools/**",
      "export/**",
      "assets/**"
    ]
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^26.8.1"
  }
}
